# --- Provider (Cline SDK) -------------------------------------------------
# Any provider id supported by the SDK, e.g. anthropic | openai-native | gemini
YOUTUBE_INGEST_PROVIDER=anthropic
YOUTUBE_INGEST_MODEL=claude-sonnet-4-6

# API key for the chosen provider. Only one is needed — the key name must match
# the provider family (see src/config.ts: PROVIDER_API_KEY_ENV).
ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# GOOGLE_API_KEY=

# --- Behaviour ------------------------------------------------------------
# Absolute path to the Obsidian vault that source notes are written into.
YOUTUBE_INGEST_VAULT=/Users/elminnurkic/Documents/Second Brain
# Preferred transcript language (ISO 639-1). Leave EMPTY to prefer the video's
# original/English track. Setting e.g. "sv" only helps if the video actually has
# a Swedish track — otherwise YouTube may return an auto-translated track, which
# is machine-translated wording rather than what was actually said. Choose
# deliberately; empty is the safe default.
YOUTUBE_INGEST_LANG=

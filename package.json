{
  "name": "youtube-ingest",
  "version": "0.1.0",
  "private": true,
  "description": "Cline SDK app: turn a YouTube video into a Second Brain source note.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "youtube-ingest": "./dist/index.js"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env --import tsx src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node --env-file-if-exists=.env dist/index.js",
    "smoke": "node --env-file-if-exists=.env --import tsx scripts/smoke.ts",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@cline/sdk": "^0.0.90",
    "youtube-transcript": "^1.3.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.0.3"
  }
}
